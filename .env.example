# PDF Table Extractor — environment variables
#
# This application requires no API keys, secrets, or external service credentials.
# All processing is local. No environment variables are required to run this app.
#
# To run:
#   python -m venv .venv
#   .venv\Scripts\activate        # Windows
#   source .venv/bin/activate     # macOS / Linux
#   pip install -r requirements.txt
#   python scripts/create_sample_pdf.py
#   streamlit run app/main.py
